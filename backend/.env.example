APP_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=career_copilot
DB_USER=career_app
DB_PASSWORD=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
JWT_SECRET=
JWT_MINUTES=30
# Maximum full Worker heartbeat age accepted by /ready, in seconds.
WORKER_HEARTBEAT_MAX_AGE=300
WORKER_CONCURRENCY=2
# Prices per million tokens. Replace illustrative zeros with vendor prices to enable estimates.
# LLM_PRICES={"your-model":{"input_per_million":"0","output_per_million":"0","currency":"CNY"}}
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Optional while using upload and local parsing. Set all three for live AI jobs.
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=deepseek-v4.1-flash
# LLM_API_KEY=
# LLM_JSON_MODE=json_object
# LLM_THINKING=disabled
# LLM_THINKING_FORMAT=enable_thinking
# LLM_TIMEOUT_SECONDS=75
# LLM_MAX_TOKENS=5500
# LLM_MAX_INPUT_CHARS=36000
